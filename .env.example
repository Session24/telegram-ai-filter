# ============================================================
# Telegram AI Filter - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Telegram User Client (Telethon) ---
# Get from https://my.telegram.org > API development tools
API_ID=
API_HASH=

# --- Telegram Bot (python-telegram-bot) ---
# Get from @BotFather
BOT_TOKEN=
# Chat/channel ID where filtered posts will be sent
TARGET_CHAT_ID=

# --- AI Provider (OpenAI-compatible API) ---
# Works with: OpenAI, NVIDIA, OpenRouter, LM Studio, Ollama, etc.
# Example: https://api.openai.com/v1 or http://localhost:1234/v1
AI_BASE_URL=
# API key (empty string if local provider without key)
AI_API_KEY=
# Model name as recognized by the provider
# Examples: gpt-4o-mini, openai/gpt-oss-20b, meta/llama-3.1-8b-instruct
AI_MODEL=

# --- Filter Settings ---
# Minimum AI score (0-100) for a post to be considered useful
MIN_AI_SCORE=70

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
